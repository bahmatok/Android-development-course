<resources>
    <style name="CalcKeyBase" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CalcKeyNumber" parent="CalcKeyBase">
        <item name="backgroundTint">@color/purple_200</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalcKeyFunction" parent="CalcKeyBase">
        <item name="backgroundTint">@color/engineering_key</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalcKeyUtility" parent="CalcKeyBase">
        <item name="backgroundTint">@color/teal_200</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalcKeyOperator" parent="CalcKeyBase">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcKeyEqual" parent="CalcKeyBase">
        <item name="backgroundTint">@color/teal_700</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
