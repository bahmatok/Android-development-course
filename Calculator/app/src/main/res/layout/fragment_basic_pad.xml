<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton style="@style/CalcKeyUtility" android:text="C" android:tag="CLEAR" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyUtility" android:text="⌫" android:tag="BACKSPACE" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyUtility" android:text="%" android:tag="%" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyOperator" android:text="÷" android:tag="/" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="7" android:tag="7" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="8" android:tag="8" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="9" android:tag="9" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyOperator" android:text="×" android:tag="*" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="4" android:tag="4" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="5" android:tag="5" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="6" android:tag="6" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyOperator" android:text="-" android:tag="-" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="1" android:tag="1" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="2" android:tag="2" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="3" android:tag="3" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyOperator" android:text="+" android:tag="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="0" android:tag="0" />
        <com.google.android.material.button.MaterialButton style="@style/CalcKeyNumber" android:text="." android:tag="." />
        <com.google.android.material.button.MaterialButton
            style="@style/CalcKeyEqual"
            android:layout_weight="2"
            android:text="="
            android:tag="EQUALS" />
    </LinearLayout>
</LinearLayout>
